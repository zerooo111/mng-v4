{
  "name": "@switchboard-xyz/on-demand",
  "version": "1.1.34",
  "description": "A Typescript client to interact with Switchboard On-Demand.",
  "license": "ISC",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "files": [
    "dist/",
    "package.json",
    "index.cjs",
    "index.js",
    "index.d.ts"
  ],
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.0",
    "@solana/web3.js": "^1.91.1",
    "@solworks/soltoolkit-sdk": "^0.0.23",
    "axios": "^1.2.0",
    "big.js": "^6.2.1",
    "bs58": "^5.0.0",
    "js-yaml": "^4.1.0",
    "node-cache": "^5.1.2",
    "protobufjs": "^7.2.6",
    "shelljs": "^0.8.5",
    "@switchboard-xyz/common": "^2.4.2"
  },
  "devDependencies": {
    "esbuild": "^0.20.1",
    "typedoc": "^0.25.9",
    "typescript": "5.4.5"
  },
  "engines": {
    "node": ">= 18"
  },
  "scripts": {
    "build": "node esbuild.js",
    "check-types": "tsc --noEmit",
    "docgen": "typedoc --out ./docs/ ./src",
    "docgen:deploy": "pnpm docgen && firebase deploy --project docs --only hosting:switchboard-docs",
    "test": "echo \"Error: no test specified\" && exit 1"
  }
}